<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS-only. Harmless (a plain static file) if Baota uses Nginx/Apache on Windows.
  Why needed: IIS has no .json MIME type by default, so /list.json would return
  404.3 and the page would fail with "通过 ajax 加载文件出错".
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".7z" />
      <mimeMap fileExtension=".7z" mimeType="application/x-7z-compressed" />
      <remove fileExtension=".rar" />
      <mimeMap fileExtension=".rar" mimeType="application/x-rar-compressed" />
      <remove fileExtension=".apk" />
      <mimeMap fileExtension=".apk" mimeType="application/vnd.android.package-archive" />
      <remove fileExtension=".iso" />
      <mimeMap fileExtension=".iso" mimeType="application/x-iso9660-image" />
      <remove fileExtension=".dmg" />
      <mimeMap fileExtension=".dmg" mimeType="application/x-apple-diskimage" />
      <remove fileExtension=".torrent" />
      <mimeMap fileExtension=".torrent" mimeType="application/x-bittorrent" />
    </staticContent>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
