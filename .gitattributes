# 统一换行符：避免 Windows 上编辑的 Shell/Python 脚本
# 在 Linux 上执行时报 "$'\r': command not found"
* text=auto

*.sh      text eol=lf
*.py      text eol=lf
*.conf    text eol=lf
*.service text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 二进制文件不做转换
*.zip   binary
*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
